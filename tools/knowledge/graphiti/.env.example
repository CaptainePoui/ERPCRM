# Copier vers .env (jamais commite) et remplir les vraies valeurs.

# Neo4j -- generer un mot de passe fort, ne jamais laisser demodemo
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_mot_de_passe_fort

# Ollama local (100% local, zero API payante) -- voir docker-compose.yml pour
# host.docker.internal et tools/knowledge/graphiti/systemd/ pour le binding Ollama.
# OPENAI_API_KEY=ollama est un placeholder non verifie par Ollama, pas une vraie cle.
OPENAI_API_KEY=ollama
OPENAI_API_URL=http://host.docker.internal:11434/v1

# gpt-oss:20b = modele valide de bout en bout le 2026-08-23 (ingestion, recherche,
# persistance apres restart) avec OLLAMA_CONTEXT_LENGTH=32768 (voir systemd/) et
# structured_output_mode=json_schema (voir config/config-docker-neo4j.yaml).
# qwen3:14b n'a jamais ete reteste dans ces conditions -- ne pas le considerer
# comme ecarte, seulement comme non (re)valide pour l'instant.
MODEL_NAME=gpt-oss:20b
EMBEDDER_MODEL=nomic-embed-text

# Namespace par defaut des episodes ingeres (peut etre surcharge par appel)
GRAPHITI_GROUP_ID=platform

# Nombre d'episodes traites en parallele -- garde bas (CPU local, pas un tier API
# distant) pour eviter de faire concurrencer plusieurs generations LLM lourdes.
SEMAPHORE_LIMIT=2

GRAPHITI_TELEMETRY_ENABLED=false
