# Copier vers .env (jamais commite) et remplir les vraies valeurs.

# Neo4j -- generer un mot de passe fort, ne jamais laisser demodemo
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_mot_de_passe_fort

# OpenAI -- LLM + embeddings (voir ARCHITECTURE_PLATFORM.md pour le choix du provider)
OPENAI_API_KEY=
MODEL_NAME=gpt-4.1-mini
EMBEDDER_MODEL=text-embedding-3-small

# Namespace par defaut des episodes ingeres (peut etre surcharge par appel)
GRAPHITI_GROUP_ID=platform

# Nombre d'episodes traites en parallele -- ajuster selon le tier OpenAI reel
SEMAPHORE_LIMIT=10
