+def is_local_ollama_provider(base_url: str | None) -> bool:
+    """Return True only for the local Ollama endpoint used by Simple IP Platform.
+
+    Strict match on http://host.docker.internal:11434/v1 (see docker-compose.yml
+    extra_hosts and systemd/ollama-resolve-docker-host.sh) -- not a bare port check,
+    which would also match a remote OpenAI-compatible endpoint that happens to use
+    Ollama's default port. host.docker.internal is Docker's own stable alias for the
+    host gateway, not a hardcoded IP, so this stays correct across reboots/migrations.
+    """
+    if not base_url:
+        return False
+
+    parsed = urlparse(base_url)
+    return (
+        parsed.scheme == 'http'
+        and parsed.hostname == 'host.docker.internal'
+        and parsed.port == 11434
+        and parsed.path.rstrip('/') == '/v1'
+    )
+
